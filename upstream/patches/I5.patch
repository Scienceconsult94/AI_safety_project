+def completion_message(simulations: list[SimulationRun]) -> str:
+    """End-of-run line; it names infrastructure errors instead of reporting success."""
+    total = len(simulations)
+    failed = sum(
+        1
+        for sim in simulations
+        if sim.termination_reason == TerminationReason.INFRASTRUCTURE_ERROR
+    )
+    review = "To review the simulations, run: [bold blue]tau2 view[/bold blue]"
+    if total and failed == total:
+        return (
+            f"\n[bold red]All {total} simulations ended with an infrastructure "
+            "error; no simulation was evaluated.[/bold red]\n"
+            "Each simulation records its error in `info`. " + review
+        )
+    if failed:
+        return (
+            f"\n[bold yellow]Completed; {failed} of {total} simulations ended with "
+            "an infrastructure error and are excluded from the metrics.[/bold yellow]\n"
+            + review
+        )
+    return (
+        "\n[bold green]Successfully completed all simulations![/bold green]\n" + review
+    )
+
