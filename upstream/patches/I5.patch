diff --git a/tests/test_runner/test_run_reporting.py b/tests/test_runner/test_run_reporting.py
new file mode 100644
index 0000000..bc77178
--- /dev/null
+++ b/tests/test_runner/test_run_reporting.py
@@ -0,0 +1,56 @@
+"""End-of-run message and agent cost of the greeting."""
+
+import pytest
+
+from tau2.data_model.message import AssistantMessage, UserMessage
+from tau2.data_model.simulation import SimulationRun, TerminationReason, TextRunConfig
+from tau2.registry import registry
+from tau2.runner.batch import completion_message
+from tau2.utils.llm_utils import get_cost
+
+
+def _sim(reason: TerminationReason) -> SimulationRun:
+    return SimulationRun(
+        id="sim",
+        task_id="0",
+        start_time="",
+        end_time="",
+        duration=0.0,
+        termination_reason=reason,
+    )
+
+
+OK = TerminationReason.USER_STOP
+INFRA = TerminationReason.INFRASTRUCTURE_ERROR
+
+
+@pytest.mark.parametrize(
+    "reasons,expected",
+    [
+        ([OK, OK], "Successfully completed all simulations!"),
+        ([OK, INFRA], "1 of 2 simulations ended with an infrastructure error"),
+        ([INFRA, INFRA], "All 2 simulations ended with an infrastructure error"),
+    ],
+)
+def test_completion_message_reports_infrastructure_errors(reasons, expected):
+    message = completion_message([_sim(reason) for reason in reasons])
+    assert expected in message
+    if INFRA in reasons:
+        assert "Successfully" not in message
+
+
+def test_greeting_has_zero_cost_so_agent_cost_is_reported():
+    from tau2.runner.build import build_text_orchestrator
+
+    task = registry.get_tasks_loader("mock")()[0]
+    orchestrator = build_text_orchestrator(TextRunConfig(domain="mock"), task)
+    greeting = orchestrator.initial_agent_message
+    assert greeting.cost == 0.0
+    messages = [
+        greeting,
+        UserMessage(role="user", content="hi", cost=0.002),
+        AssistantMessage(role="assistant", content="ok", cost=0.001),
+    ]
+    agent_cost, user_cost = get_cost(messages)
+    assert agent_cost == pytest.approx(0.001)
+    assert user_cost == pytest.approx(0.002)
