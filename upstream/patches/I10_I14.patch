--- /dev/null
+++ b/tests/test_evaluator/test_nl_assertions_reply_parsing.py
@@ -0,0 +1,92 @@
+"""Parsing of NL-assertion judge replies and matching of verdicts to assertions."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tau2.data_model.message import AssistantMessage, UserMessage
+from tau2.data_model.tasks import EvaluationCriteria, Task, UserScenario
+from tau2.evaluator.evaluator_nl_assertions import NLAssertionsEvaluator
+
+ASSERTIONS = [
+    "The agent greets the customer.",
+    "The agent confirms the refund amount.",
+]
+TRAJECTORY = [
+    AssistantMessage(role="assistant", content="Hi! How can I help you today?"),
+    UserMessage(role="user", content="###STOP###"),
+]
+TASK = Task(
+    id="nl-reply-parsing",
+    user_scenario=UserScenario(instructions="fixture"),
+    evaluation_criteria=EvaluationCriteria(nl_assertions=ASSERTIONS),
+)
+
+
+def _result(assertion: str, met: bool) -> dict:
+    return {"expectedOutcome": assertion, "reasoning": "fixture", "metExpectation": met}
+
+
+def _reward(monkeypatch, content: str):
+    import tau2.evaluator.evaluator_nl_assertions as module
+
+    monkeypatch.setattr(
+        module, "generate", lambda **kwargs: SimpleNamespace(content=content)
+    )
+    return NLAssertionsEvaluator.calculate_reward(TASK, TRAJECTORY)
+
+
+BOTH_MET = [_result(ASSERTIONS[0], True), _result(ASSERTIONS[1], True)]
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        json.dumps({"results": BOTH_MET}),
+        "```json\n" + json.dumps({"results": BOTH_MET}, indent=2) + "\n```",
+        json.dumps(BOTH_MET),
+        "```\n" + json.dumps(BOTH_MET) + "\n```",
+    ],
+    ids=["object", "fenced-object", "bare-array", "fenced-array"],
+)
+def test_accepted_reply_formats(monkeypatch, content):
+    reward = _reward(monkeypatch, content)
+    assert reward.reward == 1.0
+    assert [check.nl_assertion for check in reward.nl_assertions] == ASSERTIONS
+    assert [check.met for check in reward.nl_assertions] == [True, True]
+
+
+def test_omitted_assertion_counts_as_unmet(monkeypatch):
+    reward = _reward(
+        monkeypatch, json.dumps({"results": [_result(ASSERTIONS[0], True)]})
+    )
+    assert reward.reward == 0.0
+    assert [check.met for check in reward.nl_assertions] == [True, False]
+
+
+def test_empty_results_fail_every_assertion(monkeypatch):
+    reward = _reward(monkeypatch, json.dumps({"results": []}))
+    assert reward.reward == 0.0
+    assert [check.nl_assertion for check in reward.nl_assertions] == ASSERTIONS
+    assert not any(check.met for check in reward.nl_assertions)
+
+
+def test_results_are_matched_by_text_not_by_reply_order(monkeypatch):
+    results = [_result(ASSERTIONS[1], False), _result(ASSERTIONS[0], True)]
+    reward = _reward(monkeypatch, json.dumps({"results": results}))
+    assert [check.met for check in reward.nl_assertions] == [True, False]
+
+
+def test_paraphrased_echo_falls_back_to_position(monkeypatch):
+    results = [
+        _result("Agent greets the customer", True),
+        _result("Agent confirms the refund amount", False),
+    ]
+    reward = _reward(monkeypatch, json.dumps(results))
+    assert [check.met for check in reward.nl_assertions] == [True, False]
+
+
+def test_reply_without_results_raises(monkeypatch):
+    with pytest.raises(ValueError):
+        _reward(monkeypatch, "I cannot evaluate this conversation.")
