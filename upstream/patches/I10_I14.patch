 import json
+import re
+from typing import Any, Optional
 
 from tau2.config import DEFAULT_LLM_NL_ASSERTIONS, DEFAULT_LLM_NL_ASSERTIONS_ARGS
 from tau2.data_model.message import Message, SystemMessage, Tick, UserMessage
@@ -8,6 +10,81 @@ from tau2.evaluator.evaluator_base import EvaluatorBase
 from tau2.utils.llm_utils import generate
 from tau2.utils.transcript.views import speech_messages
 
+_CODE_FENCE = re.compile(r"```(?:json)?\s*([\s\S]*?)```")
+
+
+def parse_judge_results(content: Optional[str]) -> list[dict[str, Any]]:
+    """Return the per-assertion results of a judge reply.
+
+    Accepts the requested object ``{"results": [...]}``, a bare JSON array of
+    results, and either form inside a markdown code fence. Raises ``ValueError``
+    (``json.JSONDecodeError`` included) when the reply holds neither.
+    """
+    text = (content or "").strip()
+    fenced = _CODE_FENCE.search(text)
+    if fenced:
+        text = fenced.group(1).strip()
+    data = json.loads(text)
+    if isinstance(data, dict):
+        data = data.get("results", [])
+    if not isinstance(data, list) or not all(isinstance(r, dict) for r in data):
+        raise ValueError(f"Judge reply has no list of results: {content!r}")
+    return data
+
+
+def match_judge_results(
+    nl_assertions: list[str], results: list[dict[str, Any]]
+) -> list[NLAssertionCheck]:
+    """One check per assertion, in assertion order.
+
+    A result belongs to the assertion whose text it echoes (whitespace and case
+    ignored). Results that echo no assertion are paired by position with the
+    assertions left over, when the two counts are equal. An assertion without a
+    result counts as unmet.
+    """
+
+    def norm(text: Any) -> str:
+        return " ".join(str(text).split()).casefold()
+
+    remaining = list(results)
+    matched: list[Optional[dict[str, Any]]] = []
+    for assertion in nl_assertions:
+        hit = next(
+            (
+                r
+                for r in remaining
+                if norm(r.get("expectedOutcome", "")) == norm(assertion)
+            ),
+            None,
+        )
+        if hit is not None:
+            remaining.remove(hit)
+        matched.append(hit)
+    unmatched = [i for i, result in enumerate(matched) if result is None]
+    if unmatched and len(unmatched) == len(remaining):
+        for i, result in zip(unmatched, remaining):
+            matched[i] = result
+
+    checks = []
+    for assertion, result in zip(nl_assertions, matched):
+        if result is None:
+            checks.append(
+                NLAssertionCheck(
+                    nl_assertion=assertion,
+                    met=False,
+                    justification="The judge returned no verdict for this assertion.",
+                )
+            )
+        else:
+            checks.append(
+                NLAssertionCheck(
+                    nl_assertion=assertion,
+                    met=result.get("metExpectation", False),
+                    justification=str(result.get("reasoning", "")),
+                )
+            )
+    return checks
+
 
